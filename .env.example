# Copy this file to .env and fill in real values before running `docker compose up`.

# SQL Server "sa" password used by the sql container and the web app's connection string.
# Must satisfy SQL Server's complexity policy (8+ chars, upper/lower/digit/symbol).
SQL_SA_PASSWORD=

# Generic OpenID Connect provider used for sign-in (Keycloak, Authentik, Auth0, Entra ID, ...).
# Leave all three empty only for a quick local trial run — the app then serves every page
# without requiring login, which is not safe for any real deployment.
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
