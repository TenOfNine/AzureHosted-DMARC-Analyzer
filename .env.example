# Copy this file to .env and replace every value below with your own before running
# `docker compose up` — none of these example values are safe to deploy as-is.

# SQL Server "sa" password used by the sql container and the web app's connection string.
# Must satisfy SQL Server's complexity policy (8+ chars, upper/lower/digit/symbol).
# Example only — pick your own strong password, don't reuse this one.
SQL_SA_PASSWORD=ChangeMe!2024Strong

# Generic OpenID Connect provider used for sign-in — works with Keycloak, Authentik, Auth0,
# Entra ID, or any other standards-compliant OIDC provider you already run.
# Leave all three empty only for a quick local trial run — the app then serves every page
# without requiring login, which is not safe for any real deployment.
#
# Example below shows the shape for a self-hosted Keycloak realm named "dmarc-analyzer":
#   OIDC_AUTHORITY   = https://<your-keycloak-host>/realms/<realm-name>
#   OIDC_CLIENT_ID   = the client ID you registered in that realm
#   OIDC_CLIENT_SECRET = that client's secret (Keycloak: Clients -> your client -> Credentials)
# For Entra ID instead:      https://login.microsoftonline.com/<tenant-id>/v2.0
# For Auth0 instead:         https://<your-tenant>.us.auth0.com/
OIDC_AUTHORITY=https://keycloak.example.com/realms/dmarc-analyzer
OIDC_CLIENT_ID=dmarc-analyzer
OIDC_CLIENT_SECRET=replace-with-your-real-client-secret
